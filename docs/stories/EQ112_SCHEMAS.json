                    "type": "string",
                    "pattern": "^/(continuous|reference)/(scope|coverage|coverage_known_at_ns|observations/[0-9]+)$|^/(feed_facts|conversion_facts)/[0-9]+$"
                  },
                  "maxItems": 4096
                }
              },
